# Copy this file to .env.development.local (git-ignored) to connect to the real backend.
# .env.development.local has higher priority than .env.development, so it correctly
# overrides VITE_USE_MSW=true.
#
# VITE_USE_MSW=false  — stops MSW intercepting requests
# VITE_BACKEND_URL    — optional, defaults to http://localhost:3000
#                       Only needed if your backend runs on a different port.
#
VITE_USE_MSW=false
# VITE_BACKEND_URL=http://localhost:3000
